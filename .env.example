# Genkit OpenRouter plugin. Legacy OPEN_ROUTER_API_KEY is also supported.
OPENROUTER_API_KEY=
LLM_SYSTEM_PROMPT=
# A bare OpenRouter ID or a Genkit name prefixed with openrouter/.
LLM_MODEL=qwen/qwen3.8-27b:free
# Optional override for an OpenRouter-compatible endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

PORT=8080